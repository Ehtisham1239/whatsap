{
  "name": "wa-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant WhatsApp Business (Cloud API) messaging platform backed by Supabase Postgres.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "lint": "node --check src/index.js && for f in $(find src -name \"*.js\"); do node --check $f || exit 1; done",
    "test:smoke": "node scripts/smoke.mjs",
    "migrate": "node src/index.js migrate"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16"
  }
}
