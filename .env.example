# Supabase project "wa-platform" (ref wbrkkiqttxvhjrwuaipw).
# Use the pooled "Session" connection string from Project Settings -> Database.
# The server connects as the database owner; RLS (enabled, no policies) keeps
# the public anon/authenticated keys locked out.
DATABASE_URL=postgresql://postgres.wbrkkiqttxvhjrwuaipw:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=          # 32 bytes, base64. Encrypts WABA access tokens. Losing it means reconnecting every number.
API_KEY_PEPPER=                # >= 32 chars. Changing it invalidates every API key.
ADMIN_TOKEN=                   # >= 32 chars. Bearer token for /admin/*.

# Meta app (developers.facebook.com -> your app)
META_APP_SECRET=               # App settings -> Basic -> App secret (verifies webhook signatures)
META_VERIFY_TOKEN=             # >= 16 chars; enter the same value in the WhatsApp webhook configuration
META_GRAPH_VERSION=v23.0

PORT=8080
TRUST_PROXY=false              # true only behind a proxy that sets X-Forwarded-For
RUN_WORKERS=true               # scheduled sends, stuck-send sweeper, retention cleanup
DEFAULT_COUNTRY_CODE=92        # optional: lets callers send national numbers like 03001234567

# Credits per message (optional overrides)
PRICE_MARKETING=10
PRICE_UTILITY=4
PRICE_AUTHENTICATION=4
PRICE_SERVICE=0
